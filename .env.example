# Copy this file to .env and fill in your API keys
# Then run: setup_and_run.bat

# Anthropic (Claude) API key — required for Expert Panel, Macro Analysis, AI Screener
# Get free key at: https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_key_here

# FRED API key — required for Market Health macro data (rates, CPI, yield curve)
# Get free key at: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=your_fred_key_here

# Finnhub API key — analyst ratings, price targets, news, EPS estimates, insider transactions
# Get free key at: https://finnhub.io (free: 60 calls/min)
FINNHUB_API_KEY=your_finnhub_key_here
# Alpha Vantage API key — news sentiment scores (per-article, per-ticker NLP)
# Get free key at: https://www.alphavantage.co/support/#api-key
# NOTE: free tier is only 25 requests/DAY — results are cached 24h per symbol.
ALPHA_VANTAGE_API_KEY=your_alphavantage_key_here

# FMP (Financial Modeling Prep) — analyst rating actions, Congress trading feed
# Get free key at: https://site.financialmodelingprep.com/developer/docs
# NOTE: free tier is 250 requests/day.
FMP_API_KEY=your_fmp_key_here

# SEC EDGAR asks API clients to identify themselves (used for the 13F Smart Money tracker).
# Put your own email here. It is only sent to sec.gov in the request header.
SEC_CONTACT_EMAIL=your_email_here
